# Mexxar Production Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: Auth & Encryption
# ============================================
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="your-random-secret-here"
NEXT_PRIVATE_ENCRYPTION_KEY="your-32-char-encryption-key"
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY="your-32-char-secondary-key"

# ============================================
# REQUIRED: Application URLs
# ============================================
NEXT_PUBLIC_WEBAPP_URL="https://yourdomain.com"
NEXT_PRIVATE_INTERNAL_WEBAPP_URL="http://localhost:3000"

# ============================================
# REQUIRED: Database (Cloud PostgreSQL)
# ============================================
# AWS RDS, DigitalOcean Managed Database, etc.
NEXT_PRIVATE_DATABASE_URL="postgresql://user:password@host:5432/database"
NEXT_PRIVATE_DIRECT_DATABASE_URL="postgresql://user:password@host:5432/database"

# ============================================
# REQUIRED: Storage (S3 / DigitalOcean Spaces)
# ============================================
# For AWS S3
NEXT_PRIVATE_UPLOAD_ENDPOINT="https://s3.amazonaws.com"
NEXT_PRIVATE_UPLOAD_FORCE_PATH_STYLE="false"
NEXT_PRIVATE_UPLOAD_REGION="us-east-1"
NEXT_PRIVATE_UPLOAD_BUCKET="your-bucket-name"
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID="your-access-key"
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY="your-secret-key"

# For DigitalOcean Spaces (uncomment and use these instead)
# NEXT_PRIVATE_UPLOAD_ENDPOINT="https://nyc3.digitaloceanspaces.com"
# NEXT_PRIVATE_UPLOAD_FORCE_PATH_STYLE="false"
# NEXT_PRIVATE_UPLOAD_REGION="us-east-1"
# NEXT_PRIVATE_UPLOAD_BUCKET="your-space-name"
# NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID="your-spaces-key"
# NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY="your-spaces-secret"

# ============================================
# REQUIRED: SMTP (Email Service)
# ============================================
NEXT_PRIVATE_SMTP_TRANSPORT="smtp-auth"
NEXT_PRIVATE_SMTP_HOST="smtp.example.com"
NEXT_PRIVATE_SMTP_PORT="587"
NEXT_PRIVATE_SMTP_USERNAME="your-smtp-username"
NEXT_PRIVATE_SMTP_PASSWORD="your-smtp-password"
NEXT_PRIVATE_SMTP_SECURE="false"
NEXT_PRIVATE_SMTP_FROM_NAME="Documenso"
NEXT_PRIVATE_SMTP_FROM_ADDRESS="noreply@yourdomain.com"

# ============================================
# REQUIRED: Signing Certificate
# ============================================
# Run ./setup-cert.sh to generate certificate
NEXT_PRIVATE_SIGNING_PASSPHRASE="your-certificate-password"

# ============================================
# Optional: Background Jobs
# ============================================
# Use 'local' for single instance, or configure Inngest for distributed
NEXT_PRIVATE_JOBS_PROVIDER="local"

# ============================================
# Optional: Features
# ============================================
# Set to 1 to disable public signups
NEXT_PUBLIC_DISABLE_SIGNUP=""

# Disable telemetry
DOCUMENSO_DISABLE_TELEMETRY="true"

# Application port
PORT="3000"

# ============================================
# Optional: Google OAuth
# ============================================
NEXT_PRIVATE_GOOGLE_CLIENT_ID=""
NEXT_PRIVATE_GOOGLE_CLIENT_SECRET=""
